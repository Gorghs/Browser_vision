# Copy to .env and fill in real values. Never commit .env.
#
# Only the variables actually consumed by the current implementation are listed
# here. Later modules (screenshots, OCR, vision AI) add their own entries when
# the code that reads them exists.

# ---------------------------------------------------------------------------
# Backend runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# ---------------------------------------------------------------------------
# Supabase — backend only.
# The service-role key grants full database access and bypasses Row Level
# Security. It must never be shipped in the extension or the dashboard bundle.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
