# Copy to .env and fill in real values. Never commit .env.
#
# Only the variables the current implementation actually reads are listed here.

# ---------------------------------------------------------------------------
# Backend runtime — apps/server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Origins allowed to call the API from a browser page, comma separated.
# The extension's own origin is always allowed; it is unpredictable per install.
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Supabase — backend only.
#
# The service-role key bypasses Row Level Security and grants full database
# access. It must never be shipped in the extension or the dashboard bundle.
#
# Leave both blank to run against in-memory storage: everything works end to
# end, but data is lost when the server restarts. The server refuses to start in
# production without them.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# API authentication
#
# A shared key the extension and dashboard send as `x-api-key`. Minimum 16
# characters. Optional in development; required in production, where an
# unauthenticated ingest endpoint would accept writes from anyone.
#
# Generate one with:  openssl rand -base64 32
# ---------------------------------------------------------------------------
API_KEY=

# ---------------------------------------------------------------------------
# Dashboard — apps/dashboard
#
# Vite only exposes VITE_-prefixed variables to the browser bundle. Nothing
# secret belongs here: VITE_API_KEY is the same shared key above, and anyone
# with the dashboard open can read it. It is not a user credential.
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:3000
VITE_API_KEY=

# ---------------------------------------------------------------------------
# Screenshots
#
# Screenshot bytes go to Supabase Storage when Supabase is configured (bucket
# name below) and to SCREENSHOT_DIR otherwise. How often the analysis worker
# polls for new screenshots is set with ANALYSIS_INTERVAL_MS; 0 disables it.
# ---------------------------------------------------------------------------
SCREENSHOT_BUCKET=screenshots
SCREENSHOT_DIR=.data/screenshots
ANALYSIS_INTERVAL_MS=15000

# ---------------------------------------------------------------------------
# OCR — backend only.
#
# Uses Tesseract.js to read visible text off each screenshot before AI analysis.
# Set false to store screenshots without ever reading them.
# ---------------------------------------------------------------------------
OCR_ENABLED=true

# ---------------------------------------------------------------------------
# Vision AI — backend only.
#
# Optional. The provider abstraction supports Gemini and OpenAI (and any
# OpenAI-compatible endpoint via AI_BASE_URL). With no provider configured the
# pipeline still stores and OCRs screenshots and builds timelines from events;
# only the structured analysis stays empty.
#
# AI_PROVIDER and AI_API_KEY must be set together, or neither.
# ---------------------------------------------------------------------------
AI_PROVIDER=
AI_API_KEY=
# AI_MODEL=
# AI_BASE_URL=
